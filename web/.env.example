# Local web development. Copy to web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_MODE=false

# Optional Google OAuth Web client ID. This value is visible in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional Clerk. Rebuild the web app when changing NEXT_PUBLIC_* values.
# Keep disabled until the backend's matching Clerk configuration is enabled.
NEXT_PUBLIC_CLERK_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Keep middleware redirects aligned with the app's custom authentication routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Server-only secret for Clerk middleware; never prefix this key with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Optional Sentry monitoring. Blank DSNs keep all reporting disabled.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Server-side Sentry settings. SENTRY_DSN can use the same project DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0

# Optional source-map upload settings for readable production stack traces.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
