# Local web development. Copy to web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_MODE=false

# Optional Google OAuth Web client ID. This value is visible in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional Sentry monitoring. Blank DSNs keep all reporting disabled.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Server-side Sentry settings. SENTRY_DSN can use the same project DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0

# Optional source-map upload settings for readable production stack traces.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
