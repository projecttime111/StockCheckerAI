# Render backend production variables for an existing or new Neon database.
# For a new project, select PostgreSQL 16 with the current backend dependencies.
# Do not add this file or any real secret to Vercel.
SPRING_PROFILES_ACTIVE=prod

# Runtime traffic: use Neon's pooled endpoint when available.
DATABASE_URL="jdbc:postgresql://your-neon-pooled-host/neondb?sslmode=require&channelBinding=require"
DATABASE_USERNAME=your_neon_database_role
DATABASE_PASSWORD=your_neon_database_password

# Flyway migrations: use the direct endpoint without "-pooler".
# FLYWAY_USERNAME and FLYWAY_PASSWORD can be omitted when they match DATABASE_*.
FLYWAY_URL="jdbc:postgresql://your-neon-direct-host/neondb?sslmode=require&channelBinding=require"
FLYWAY_USERNAME=your_neon_database_role
FLYWAY_PASSWORD=your_neon_database_password

DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=0
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_VALIDATION_TIMEOUT_MS=5000

JWT_SECRET=replace_with_a_new_private_64_plus_character_random_secret
JWT_ACCESS_TOKEN_MINUTES=120
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
APP_PUBLIC_URL=https://your-project.vercel.app

CACHE_TYPE=simple
MANAGEMENT_HEALTH_REDIS_ENABLED=false
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

APP_AUTH_REQUIRE_EMAIL_VERIFICATION=true
APP_AUTH_VERIFICATION_TOKEN_HOURS=24
APP_AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
APP_AUTH_EMAIL_COOLDOWN_SECONDS=60

EMAIL_PROVIDER=resend
EMAIL_FROM="StockPilot AI <noreply@yourdomain.com>"
RESEND_API_KEY=your_resend_api_key

# Optional Google sign-in. This is a public OAuth Web client ID, not a secret.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# Optional Clerk: deliberately disabled until real instance settings are supplied.
# Match CLERK_AUTHORIZED_PARTIES to the exact web origin(s), without paths or trailing slashes.
APP_CLERK_ENABLED=false
APP_CLERK_LEGACY_MIGRATION_ENABLED=false
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_SECRET_KEY=
CLERK_JWT_PUBLIC_KEY=
# Exact trusted verified Clerk emails (or existing local/Google accounts); remove after bootstrap.
APP_PLATFORM_ADMIN_EMAILS=

# Fixed safe production behavior.
APP_DEMO_SEED_ENABLED=false
APP_DEV_TOOLS_ENABLED=false
SWAGGER_PUBLIC_ENABLED=false
LOCAL_STORAGE_ROOT=/app/uploads

# Phase 1 production logging. Sentry stays disabled until a real DSN is added.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
