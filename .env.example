# Local Spring Boot backend settings.
# Copy this file to .env, keep the copy private, then run:
#   ./backend/scripts/run-with-root-env.sh

SPRING_PROFILES_ACTIVE=dev

# Local PostgreSQL. For Neon, use the JDBC values from .env.neon.example.
DATABASE_URL=jdbc:postgresql://localhost:5432/stockpilot
DATABASE_USERNAME=stockpilot
DATABASE_PASSWORD=stockpilot
FLYWAY_URL=jdbc:postgresql://localhost:5432/stockpilot
FLYWAY_USERNAME=stockpilot
FLYWAY_PASSWORD=stockpilot

# Connection limits that are safe for local development and small Neon deployments.
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=0
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_VALIDATION_TIMEOUT_MS=5000

# Local-only value. Generate a new private value for Render.
JWT_SECRET=local-dev-only-change-this-secret-local-dev-only-change-this-secret
JWT_ACCESS_TOKEN_MINUTES=120

APP_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_AUTH_REQUIRE_EMAIL_VERIFICATION=false
APP_AUTH_VERIFICATION_TOKEN_HOURS=24
APP_AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
APP_AUTH_EMAIL_COOLDOWN_SECONDS=60

# Local email logs links instead of sending them.
EMAIL_PROVIDER=local
EMAIL_FROM="StockPilot AI <noreply@example.com>"
RESEND_API_KEY=

# Optional Google sign-in. Use the same public Web client ID in web/.env.local.
GOOGLE_CLIENT_ID=

# The deployed backend currently uses the simple in-process cache.
CACHE_TYPE=simple
MANAGEMENT_HEALTH_REDIS_ENABLED=false
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# Uploaded files are local. A production host needs durable storage for persistence.
LOCAL_STORAGE_ROOT=uploads
UPLOAD_MAX_FILE_SIZE=150MB
UPLOAD_MAX_REQUEST_SIZE=160MB
IMPORT_MAX_UPLOAD_SIZE=150MB

APP_DEMO_SEED_ENABLED=false
APP_DEV_TOOLS_ENABLED=false
SWAGGER_PUBLIC_ENABLED=true

# Optional integrations; blank values keep the local behavior.
LLM_ENDPOINT=
LLM_API_KEY=
